.privacy-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
.privacy-popup {
  width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx 24rpx;
  box-sizing: border-box;
}
.privacy-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  color: #333;
}
.privacy-content {
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #666;
}
.privacy-link {
  color: #1677ff;
}
.privacy-btns {
  display: flex;
  margin-top: 32rpx;
  gap: 20rpx;
}
.privacy-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  border-radius: 12rpx;
  margin: 0;
  padding: 0;
}
.privacy-btn.disagree {
  background: #f5f5f5;
  color: #666;
}
.privacy-btn.agree {
  background: linear-gradient(135deg, #1677ff, #0958d9);
  color: #fff;
}
