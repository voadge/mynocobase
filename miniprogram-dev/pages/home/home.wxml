<view class="page {{theme}}">
  <view class="attend-btn-wrap">
    <button class="attend-btn" bindtap="goAttend">📌 考勤打卡</button>
  </view>

  <view class="tracking-bar {{trackingActive ? 'active' : ''}}" wx:if="{{trackingActive}}">
    <text class="tracking-icon">🛰️</text>
    <text class="tracking-text">野外作业安全监控运行中</text>
  </view>

  <view class="homepage-btn-wrap">
    <button class="homepage-btn" bindtap="goHomepage">🏠 首页</button>
  </view>

  <view class="section-list">
    <view class="section-group" wx:for="{{workSections}}" wx:key="title">
      <view class="section-header" bindtap="toggleSection" data-idx="{{index}}">
        <view class="section-accent" style="background:{{item.accent}}"></view>
        <text class="section-title">{{item.title}}</text>
        <text class="section-arrow">{{collapsed[index] ? '▶' : '▼'}}</text>
      </view>
      <view class="btn-grid" wx:if="{{!collapsed[index]}}">
        <view class="btn-item"
          wx:for="{{item.items}}" wx:key="label"
          data-url="{{item.url}}"
          bindtap="goWebview">{{item.label}}</view>
      </view>
    </view>
  </view>
</view>
