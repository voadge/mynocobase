.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
  --bg: #f5f5f5;
  --card-bg: #fff;
  --text: #333;
  --text-secondary: #666;
  --btn-bg: #f5f7fa;
  --btn-text: #333;
  --shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.page.dark {
  --bg: #1a1a1a;
  --card-bg: #2a2a2a;
  --text: #e0e0e0;
  --text-secondary: #aaa;
  --btn-bg: #3a3a3a;
  --btn-text: #e0e0e0;
  --shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.attend-btn-wrap {
  padding: 24rpx 24rpx 0;
}
.attend-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #1677ff, #0958d9);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(22,119,255,0.3);
}

.section-list {
  padding: 20rpx 24rpx 0;
}
.section-group {
  background: var(--card-bg);
  border-radius: 14rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
}
.section-header {
  display: flex;
  align-items: center;
  padding: 20rpx 20rpx 0;
}
.section-accent {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}
.btn-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 20rpx 20rpx;
}
.btn-item {
  padding: 16rpx 0;
  border-radius: 10rpx;
  background: var(--btn-bg);
  color: var(--btn-text);
  font-size: 26rpx;
  text-align: center;
  width: calc((100% - 12rpx) / 2);
  box-sizing: border-box;
}
