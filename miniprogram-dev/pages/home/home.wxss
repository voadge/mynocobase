.page {
  min-height: 100vh;
  padding: 0 0 40rpx 0;
}
.header {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx 20rpx;
}
.logo-placeholder {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  background: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}
.header-text { flex: 1; }
.title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}
.subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.attend-btn-wrap { padding: 24rpx 30rpx 0; }
.attend-main-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #1677ff;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
}
.section-list { padding: 24rpx 24rpx 0; }
.section-group {
  border-radius: 16rpx;
  border: 1px solid #eee;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #fafafa;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.btn-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.btn-item {
  padding: 12rpx 20rpx;
  border-radius: 10rpx;
  border: 1px solid;
  font-size: 24rpx;
  text-align: center;
  box-sizing: border-box;
}
