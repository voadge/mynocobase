.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
  --bg: #f5f5f5;
  --card-bg: #fff;
  --text: #333;
  --text-secondary: #666;
  --btn-bg: #f5f7fa;
  --btn-text: #333;
  --shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.page.dark {
  --bg: #1a1a1a;
  --card-bg: #2a2a2a;
  --text: #e0e0e0;
  --text-secondary: #aaa;
  --btn-bg: #3a3a3a;
  --btn-text: #e0e0e0;
  --shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}
.page.dark .tracking-bar {
  background: #1a3050;
  color: #66b5ff;
}

.attend-btn-wrap {
  padding: 24rpx 24rpx 0;
}
.attend-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #1677ff, #0958d9);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(22,119,255,0.3);
}

.tracking-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 12rpx 24rpx 0;
  padding: 12rpx;
  border-radius: 10rpx;
  background: #e6f7ff;
  color: #1677ff;
  font-size: 24rpx;
}
.tracking-icon { margin-right: 8rpx; font-size: 28rpx; }
.tracking-text { font-weight: 500; }

.homepage-btn-wrap {
  padding: 12rpx 24rpx 0;
}
.homepage-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--card-bg);
  color: var(--text);
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 14rpx;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--btn-bg);
}

.section-list {
  padding: 20rpx 24rpx 0;
}
.section-group {
  background: var(--card-bg);
  border-radius: 14rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
}
.section-header {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  cursor: pointer;
}
.section-accent {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.section-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}
.section-arrow {
  font-size: 20rpx;
  color: #bbb;
  margin-left: 12rpx;
  transition: transform 0.2s;
}
.btn-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 20rpx 20rpx;
}
.btn-item {
  padding: 16rpx 0;
  border-radius: 10rpx;
  background: var(--btn-bg);
  color: var(--btn-text);
  font-size: 26rpx;
  text-align: center;
  width: calc((100% - 12rpx) / 2);
  box-sizing: border-box;
}
