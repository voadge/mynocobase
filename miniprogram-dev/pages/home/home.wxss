.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}
.attend-btn-wrap {
  padding: 24rpx 24rpx 0;
}
.attend-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #1677ff, #0958d9);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(22,119,255,0.3);
}

.section-list {
  padding: 20rpx 24rpx 0;
}
.section-group {
  background: #fff;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 14rpx;
}
.btn-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.btn-item {
  padding: 14rpx 22rpx;
  border-radius: 8rpx;
  background: #f5f7fa;
  color: #444;
  font-size: 26rpx;
  text-align: center;
  box-sizing: border-box;
}
