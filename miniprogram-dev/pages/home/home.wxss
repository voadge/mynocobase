.page {
  min-height: 100vh;
  background: var(--bg, #f5f5f5);
  padding-bottom: 40rpx;
  --bg: #f5f5f5;
  --card-bg: #fff;
  --text: #333;
  --text-secondary: #999;
  --btn-bg: #f5f7fa;
  --btn-text: #333;
  --btn-hover-bg: #e9edf2;
  --card-hover: #fafbfc;
  --shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.page.dark {
  --bg: #1a1a1a;
  --card-bg: #2a2a2a;
  --text: #e0e0e0;
  --text-secondary: #888;
  --btn-bg: #3a3a3a;
  --btn-text: #e0e0e0;
  --btn-hover-bg: #444;
  --card-hover: #323232;
  --shadow: 0 4rpx 16rpx rgba(0,0,0,0.25);
}

.app-header {
  position: relative;
  overflow: hidden;
  padding: 56rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #1677ff, #0958d9);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(9,88,217,0.25);
}
.app-header::after {
  content: '';
  position: absolute;
  right: -50rpx;
  top: -60rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.10);
}
.app-header::before {
  content: '';
  position: absolute;
  right: 110rpx;
  bottom: -70rpx;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.07);
}
.app-title {
  position: relative;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.app-sub {
  position: relative;
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 10rpx;
}

.card {
  background: var(--card-bg);
  border-radius: 18rpx;
  box-shadow: var(--shadow);
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
}

.attend-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 150rpx;
  padding-top: 30rpx;
  padding-bottom: 30rpx;
}
.attend-info {
  flex: 1;
  min-width: 0;
}
.attend-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.attend-status {
  display: inline-block;
  align-self: flex-start;
  margin-top: 10rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.attend-status::before {
  content: '';
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  vertical-align: middle;
  background: currentColor;
}
.attend-status.ongoing { background: #e6f7ff; color: #1677ff; }
.attend-status.done { background: #e8f8ef; color: #0f9d58; }
.attend-status.none { background: #f0f0f0; color: var(--text-secondary); }
.page.dark .attend-status.ongoing { background: #14304a; color: #66b5ff; }
.page.dark .attend-status.done { background: #143524; color: #5ad18c; }
.page.dark .attend-status.none { background: #3a3a3a; color: var(--text-secondary); }
.attend-btn {
  width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  background: linear-gradient(135deg, #1677ff, #0958d9);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(22,119,255,0.3);
}
.btn-hover { opacity: 0.85; transform: scale(0.97); }

.tracking-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 24rpx 0;
  padding: 22rpx 16rpx;
  min-height: 90rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.tracking-bar.active {
  background: #e6f7ff;
  color: #1677ff;
}
.page.dark .tracking-bar.active {
  background: #14304a;
  color: #66b5ff;
}
.tracking-bar.inactive {
  background: var(--card-bg);
  color: var(--text-secondary);
  border: 1rpx solid var(--btn-bg);
}
.live-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #52c41a;
  margin-right: 10rpx;
  animation: pulse 1.6s infinite;
}
@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(82,196,26,0.6); }
  70% { box-shadow: 0 0 0 12rpx rgba(82,196,26,0); }
  100% { box-shadow: 0 0 0 0 rgba(82,196,26,0); }
}
.tracking-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}
.tracking-text {
  font-weight: 500;
}

.homepage-card {
  padding: 16rpx 24rpx;
}
.homepage-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--btn-bg);
  color: var(--btn-text);
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 12rpx;
}

.list-title {
  margin: 36rpx 24rpx 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.section-list {
  padding: 0 24rpx;
}
.section-group {
  background: var(--card-bg);
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
}
.section-header {
  display: flex;
  align-items: center;
  padding: 28rpx 20rpx;
}
.section-hover { background: var(--card-hover); }
.section-letter {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
}
.section-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}
.section-arrow {
  font-size: 20rpx;
  color: #bbb;
  margin-left: 12rpx;
}
.btn-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 20rpx 20rpx;
}
.btn-item {
  padding: 16rpx 0;
  border-radius: 10rpx;
  background: var(--btn-bg);
  color: var(--btn-text);
  font-size: 26rpx;
  text-align: center;
  width: calc((100% - 12rpx) / 2);
  box-sizing: border-box;
}
.item-hover { background: var(--btn-hover-bg) !important; }

.footer {
  text-align: center;
  color: var(--text-secondary);
  font-size: 20rpx;
  padding: 36rpx 24rpx 8rpx;
}

.privacy-guide {
  margin: 16rpx 30rpx 0;
  padding: 20rpx;
  background: #fff7e6;
  border: 1px solid #ffd591;
  border-radius: 12rpx;
}
.privacy-guide-text {
  font-size: 24rpx;
  color: #ad6800;
  margin-bottom: 16rpx;
}
.privacy-guide-btn {
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: #1677ff;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
}
.privacy-guide-btn::after { border: none; }
