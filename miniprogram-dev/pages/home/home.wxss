.page {
  min-height: 100vh;
  background: #0a0e1a;
  padding: 0 0 40rpx 0;
}
.header {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx 20rpx;
  background: linear-gradient(135deg, #0d1322 0%, #141b2b 50%, #0d1322 100%);
  border-bottom: 1px solid rgba(59, 130, 246, 0.15);
}
.logo {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
}
.header-text {
  flex: 1;
}
.title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #e8edf5;
  letter-spacing: 2rpx;
}
.subtitle {
  display: block;
  font-size: 24rpx;
  color: #5a6a7a;
  margin-top: 4rpx;
}
.attend-btn-wrap {
  padding: 24rpx 30rpx 0;
}
.attend-main-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #1677ff, #0958d9);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(22, 119, 255, 0.35);
}
.section-list {
  padding: 24rpx 24rpx 0;
}
.section-group {
  border-radius: 16rpx;
  border: 1px solid;
  margin-bottom: 20rpx;
  padding: 20rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.btn-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.btn-item {
  padding: 12rpx 20rpx;
  border-radius: 10rpx;
  border: 1px solid;
  font-size: 24rpx;
  text-align: center;
  box-sizing: border-box;
}
