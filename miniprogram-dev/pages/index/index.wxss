.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 40rpx;
}
.loading { text-align: center; }
.loading-spinner {
  width: 60rpx; height: 60rpx;
  border: 4rpx solid #1a2332;
  border-top: 4rpx solid #1677ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { color: #5a6a7a; font-size: 28rpx; }
.bind-tip { text-align: center; padding: 40rpx; }
.bind-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.bind-title { font-size: 32rpx; color: #e8edf5; display: block; margin-bottom: 12rpx; }
.bind-desc { font-size: 26rpx; color: #5a6a7a; display: block; margin-bottom: 40rpx; }
.bind-btn {
  background: linear-gradient(135deg, #1677ff, #0958d9);
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.error-tip { text-align: center; padding: 40rpx; }
.error-icon { font-size: 60rpx; display: block; margin-bottom: 16rpx; }
.error-text { color: #ff4d4f; font-size: 28rpx; display: block; margin-bottom: 30rpx; }
.retry-btn {
  background: transparent;
  border: 1px solid #1677ff;
  color: #1677ff;
  padding: 16rpx 50rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}
