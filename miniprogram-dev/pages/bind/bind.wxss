.page { min-height: 100vh; background: #0a0e1a; }
.loading-wrap { display: flex; align-items: center; justify-content: center; height: 100vh; color: #5a6a7a; font-size: 28rpx; }
.content { padding: 20rpx; }
.search-bar { margin-bottom: 16rpx; }
.search-input {
  width: 100%;
  padding: 20rpx;
  background: #1a2332;
  border: 1px solid #2a3a4a;
  border-radius: 12rpx;
  color: #e0e6ed;
  font-size: 28rpx;
  box-sizing: border-box;
}
.error { color: #ff4d4f; font-size: 26rpx; text-align: center; margin-bottom: 16rpx; }
.user-list { height: calc(100vh - 180rpx); }
.user-item {
  padding: 24rpx 20rpx;
  background: #1a2332;
  border-radius: 10rpx;
  margin-bottom: 10rpx;
}
.user-name { font-size: 28rpx; color: #e8edf5; }
.user-dept { font-size: 24rpx; color: #5a6a7a; margin-top: 4rpx; }
