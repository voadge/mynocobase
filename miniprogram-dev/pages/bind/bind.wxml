<view class="page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <text>加载用户列表...</text>
  </view>
  <view wx:else class="content">
    <view class="search-bar">
      <input class="search-input" placeholder="搜索姓名或部门" value="{{search}}" bindinput="onSearch"></input>
    </view>
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <scroll-view class="user-list" scroll-y>
      <view class="user-item" wx:for="{{filteredUsers}}" wx:key="id" data-id="{{item.id}}" bindtap="selectUser">
        <view class="user-name">{{item.nickname}}</view>
        <view class="user-dept" wx:if="{{item.department}}">{{item.department}}</view>
      </view>
    </scroll-view>
  </view>
</view>
