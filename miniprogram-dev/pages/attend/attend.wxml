<view class="page">
  <privacy-popup />
  <view class="header">
    <text class="title">📸 考勤打卡</text>
    <text class="time">🕐 {{clockText}}</text>
  </view>

  <view class="status-bar" wx:if="{{attendState && attendState.statusText}}">
    <text class="status-text">{{attendState.statusText}}</text>
  </view>

  <view class="notice" style="font-size:22rpx;color:#888;padding:8rpx 24rpx;line-height:1.5;">🛰️ 上班后将每 15 分钟采集位置，用于野外作业安全监控（可在系统设置中关闭）</view>

  <view class="type-tabs">
    <view class="type-tab {{attendType==='上班'?'selected':''}}" data-type="上班" bindtap="chooseAttendType">✅ 上班</view>
    <view class="type-tab {{attendType==='下班'?'selected':''}}" data-type="下班" bindtap="chooseAttendType">🏠 下班</view>
    <view class="type-tab {{attendType==='请假'||attendType==='调休'||attendType==='出差'?'selected':''}}" data-type="leave" bindtap="chooseAttendType">📋 假勤</view>
  </view>

  <view class="sub-tabs" wx:if="{{showLeaveForm}}">
    <view class="type-tab sub {{attendType==='请假'?'selected':''}}" data-type="请假" bindtap="chooseAttendType">📋 请假</view>
    <view class="type-tab sub {{attendType==='调休'?'selected':''}}" data-type="调休" bindtap="chooseAttendType">📅 调休</view>
    <view class="type-tab sub {{attendType==='出差'?'selected':''}}" data-type="出差" bindtap="chooseAttendType">🚗 出差</view>
  </view>

  <view class="photo-wrap" wx:if="{{!showLeaveForm}}">
    <view class="photo-area" bindtap="takePhoto">
      <image wx:if="{{photoPath}}" src="{{photoPath}}" class="photo-preview"></image>
      <view wx:else class="photo-placeholder">📷 拍照</view>
    </view>
    <text class="photo-hint">{{photoPath ? '✅ 已拍照' : '点击拍照'}}</text>
  </view>

  <view class="privacy-guide" wx:if="{{privacyNeedsAgree}}">
    <view class="privacy-guide-text">🔒 首次使用定位需先同意隐私保护指引</view>
    <button id="agree-privacy-btn" class="privacy-guide-btn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onPrivacyAgreed">同意隐私并开启定位</button>
  </view>

  <view class="info-section">
    <view class="info-row" bindtap="retryLocate">
      <text class="info-label">📍 定位</text>
      <text class="info-value {{gpsState==='ok'?'ok':'fail'}}">
        <text wx:if="{{gpsState==='ok'}}">✅ 已获取</text>
        <text wx:elif="{{gpsState==='denied'}}">❌ 权限被拒绝</text>
        <text wx:elif="{{gpsState==='timeout'}}">⏰ 定位超时</text>
        <text wx:elif="{{gpsState==='fail'}}">❌ 定位失败</text>
        <text wx:else>获取中...</text>
      </text>
    </view>
    <view class="info-row" wx:if="{{coordText}}">
      <text class="info-label">🌐 坐标</text>
      <text class="info-value">{{coordText}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">📍 围栏</text>
      <text class="info-value" style="color:{{fenceColor}}">{{fenceText}}</text>
    </view>
    <view class="info-row" wx:if="{{fenceResult && fenceResult.fenceName}}">
      <text class="info-label">围栏名称</text>
      <text class="info-value">{{fenceResult.fenceName}}</text>
    </view>
    <view class="info-row" wx:if="{{fenceResult && fenceResult.distance != null}}">
      <text class="info-label">距离</text>
      <text class="info-value">{{fenceResult.distance}}m</text>
    </view>
  </view>

  <view class="leave-form" wx:if="{{showLeaveForm}}">
    <view class="form-row">
      <text class="form-label">开始时间</text>
      <picker mode="date" value="{{leaveStartDate}}" bindchange="bindLeaveStart">
        <view class="form-input">{{leaveStartDate || '点击选择日期'}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">结束时间</text>
      <picker mode="date" value="{{leaveEndDate}}" bindchange="bindLeaveEnd">
        <view class="form-input">{{leaveEndDate || '点击选择日期'}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">事由说明</text>
      <textarea class="form-textarea" value="{{leaveReason}}" bindinput="bindLeaveReason" placeholder="请输入事由..."></textarea>
    </view>
  </view>

  <button class="submit-btn {{submitting?'disabled':''}}" disabled="{{submitting}}" bindtap="submitAttendance">
    {{submitText}}
  </button>
</view>
